# ====================================================================
# C/C++ Compiled Binaries & Object Files
# ====================================================================
*.o
*.obj
*.out
*.exe
*.app

# Common build and binary directory names
bin/
build/
obj/
.tmp/
data/setup_cod_paralelos/

# ====================================================================
# Neovim & Tooling (LSP / Formatting / Auto-save)
# ====================================================================
# Neovim swap, backup, and undo files
*.swp
*.swo
*~
.netrwhist

# Compilation database generated by 'bear' or CMake
# (Keep this ignored so it doesn't clutter your git commits)
compile_commands.json
.clangd/

# GDB debugger
.gdb_history

# Auto-save plugin artifacts (if any temporary backups are made)
.auto-save-*

# ====================================================================
# JetBrains CLion
# ====================================================================
# Ignore the entire IDE configuration directory
.idea/

# CMake configuration artifacts generated by CLion
cmake-build-debug/
cmake-build-release/

# ====================================================================
# Operating System files
# ====================================================================
.DS_Store
Thumbs.db
